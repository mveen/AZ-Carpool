rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Trust model
    //   - Everyone is signed in anonymously, so "signed in" means only "opened the URL".
    //   - A MEMBER is either the coordinator, or someone whose own links/{uid} doc points
    //     at a family that still exists.
    //   - A links/{uid} doc can only be created by quoting a valid invite code AND one of
    //     that family's phone numbers. That check happens HERE, not only in the browser.
    //   - Invite codes live in /invites/{code}. Nobody can list that collection except the
    //     coordinator; anyone can look up one code they already know.
    // ------------------------------------------------------------------
    function signedIn() { return request.auth != null; }

    function coordPath() { return /databases/$(database)/documents/config/coordinator; }
    function myLinkPath() { return /databases/$(database)/documents/links/$(request.auth.uid); }
    function hasLink() { return exists(myLinkPath()); }
    function linkedFamilyId() { return get(myLinkPath()).data.familyId; }

    function coordByUid() {
      let cfg = get(coordPath()).data;
      return ('uid' in cfg) && cfg.uid == request.auth.uid;
    }
    function coordByFamily() {
      let cfg = get(coordPath()).data;
      return ('familyId' in cfg) && hasLink() && linkedFamilyId() == cfg.familyId;
    }
    // Coordinator status is either tied to the browser that first claimed it (uid), or to
    // whichever family is designated "coordinator gezin" in Beheer.
    function isCoordinator() {
      return signedIn() && exists(coordPath()) && (coordByUid() || coordByFamily());
    }
    function isLinked() {
      return signedIn() && hasLink()
        && exists(/databases/$(database)/documents/families/$(linkedFamilyId()));
    }
    function isMember() { return isCoordinator() || isLinked(); }

    // A parent creating/replacing their own link must quote a real invite code for that
    // family, plus a normalised phone number that is on that family's phoneKeys list.
    function validInviteLink() {
      let d = request.resource.data;
      let invite = /databases/$(database)/documents/invites/$(d.code);
      let family = /databases/$(database)/documents/families/$(d.familyId);
      return d.keys().hasOnly(['familyId', 'code', 'phoneKey', 'linkedAt'])
        && d.familyId is string && d.code is string && d.phoneKey is string
        && d.phoneKey.size() >= 8
        && exists(invite) && get(invite).data.familyId == d.familyId
        && exists(family)
        && ('phoneKeys' in get(family).data)
        && d.phoneKey in get(family).data.phoneKeys;
    }

    // ---- Coordinator claim --------------------------------------------------------
    // First person to create this doc becomes coordinator (first-run only). It can never
    // be deleted again, otherwise the "claim coordinator" screen would reopen for anyone.
    match /config/coordinator {
      allow read: if signedIn();   // needed before linking, to know whether to show the claim screen
      allow create: if signedIn() && !exists(coordPath());
      allow update: if isCoordinator();
      allow delete: if false;
    }

    // ---- Invite codes (doc id = the code) ------------------------------------------
    match /invites/{code} {
      allow get: if signedIn();          // look up ONE code you already know
      allow list: if isCoordinator();    // only the coordinator can see all codes
      // A NEW code has at least 8 characters (the app generates 10 digits). Codes made before this rule stay valid and can still be updated or removed.
      allow create: if isCoordinator()
        && code.size() >= 8
        && request.resource.data.keys().hasOnly(['familyId'])
        && request.resource.data.familyId is string;
      // A code can never be silently moved to another family.
      allow update: if isCoordinator()
        && request.resource.data.keys().hasOnly(['familyId'])
        && request.resource.data.familyId == resource.data.familyId;
      allow delete: if isCoordinator();
    }

    // ---- Links: which browser belongs to which family ------------------------------
    match /links/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoordinator());
      allow list: if isCoordinator();
      allow create, update: if signedIn() && request.auth.uid == uid
        && (validInviteLink() || isCoordinator());
      allow delete: if signedIn() && (request.auth.uid == uid || isCoordinator());
    }

    // ---- Sessions: when a linked browser last opened the app (shown to the coordinator) ----
    // Only a timestamp and the family the browser is linked to; written by the browser itself.
    match /sessions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoordinator());
      allow list: if isCoordinator();
      allow create, update: if signedIn() && request.auth.uid == uid && isLinked()
        && request.resource.data.keys().hasOnly(['familyId', 'at'])
        && request.resource.data.familyId == linkedFamilyId()
        && request.resource.data.at is number;
      allow delete: if signedIn() && (request.auth.uid == uid || isCoordinator());
    }

    // ---- Error log: what went wrong in someone's browser (see error-log.js) ---------------
    // Anyone with a session may write, but only into their OWN 10 slots (<uid>_0 ... <uid>_9, so one browser can never fill the
    // database), only these fields and only short values. Only the coordinator can read or delete the log; the weekly purge job
    // on the server deletes entries after 30 days. The app never puts names, phone numbers or codes in it.
    function validErrorEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['at', 'where', 'code', 'msg', 'v', 'ua'])
        && d.keys().hasAll(['at', 'where', 'code', 'msg', 'v', 'ua'])
        && d.at is number
        && d.where is string && d.where.size() <= 40
        && d.code is string && d.code.size() <= 60
        && d.msg is string && d.msg.size() <= 200
        && d.v is string && d.v.size() <= 20
        && d.ua is string && d.ua.size() <= 60;
    }
    match /errorLog/{entryId} {
      allow get, list: if isCoordinator();
      allow create, update: if signedIn() && entryId.matches(request.auth.uid + '_[0-9]') && validErrorEntry();
      allow delete: if isCoordinator();
    }

    // ---- Families ------------------------------------------------------------------
    // Readable by members only (the Rooster needs names, times and — for the WhatsApp
    // links — phone numbers). Parents may only edit their OWN family.
    match /families/{familyId} {
      allow read: if isMember();
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator() || (isLinked() && linkedFamilyId() == familyId);
    }

    // ---- Rooster + settings --------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isMember();
      allow write: if isCoordinator();
    }
    // lastUpdateDeviation and matchCache must be writable by any member (the Dagafwijking
    // and match-carpool features), so they get their own rules ahead of the general one.
    match /settings/lastUpdateDeviation {
      allow read, write: if isMember();
    }
    match /settings/matchCache {
      allow read, write: if isMember();
    }
    // Calculated distances of away matches (US-21): every member reads them. They are written by the daily server job (cron/match-calendars.mjs,
    // service account, outside these rules) and by the coordinator's own app; a parent's browser never calculates or writes them.
    match /settings/matchDistances {
      allow read: if isMember();
      allow write: if isCoordinator();
    }
    // API keys that must not be public (OpenRouteService): read and written by the coordinator only. The daily server job reads the key with its
    // service account. A parent never needs it: the distances are calculated on the server and stored in settings/matchDistances.
    match /settings/apiKeys {
      allow read, write: if isCoordinator();
    }
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isCoordinator();
    }

    // ---- Afwijkend weekrooster: the requests (see weekrooster.js) ----
    // The feature is always on. (The old switch document settings/weekrooster is no longer read or written; it may stay in the database.)
    // Is the linked family the day coordinator of this weekday (settings/dayCoordinators = { Ma: familyId, ... })?
    function isDayCoordinatorOf(day) {
      let p = /databases/$(database)/documents/settings/dayCoordinators;
      return isLinked() && exists(p) && (day in get(p).data) && get(p).data[day] == linkedFamilyId();
    }
    // The real coordinator decides every day (also when no day coordinator is set); a day coordinator decides only his own day.
    function mayDecideRequest(day) { return isCoordinator() || isDayCoordinatorOf(day); }
    // The shape of a request: only times and "rijdt mee", one document per family per day. NO field for a reason or any free text.
    function validRequest(reqId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['weekKey', 'day', 'familyId', 'rides', 'heen', 'terug', 'status', 'createdAt', 'updatedAt', 'decidedAt', 'decidedBy', 'test'])
        && d.keys().hasAll(['weekKey', 'day', 'familyId', 'rides', 'heen', 'terug', 'status', 'createdAt', 'updatedAt'])
        && d.weekKey is string && d.weekKey.matches('[0-9]{4}-W[0-9]{2}')
        && d.day in ['Ma', 'Di', 'Wo', 'Do', 'Vr']
        && d.familyId is string && reqId == d.weekKey + '_' + d.day + '_' + d.familyId
        && d.rides is bool && d.heen is string && d.terug is string
        && (d.rides
            ? ((d.heen == '' || d.heen.matches('([01][0-9]|2[0-3]):[0-5][0-9]')) && (d.terug == '' || d.terug.matches('([01][0-9]|2[0-3]):[0-5][0-9]')) && (d.heen != '' || d.terug != ''))
            : (d.heen == '' && d.terug == ''))
        && d.status in ['pending', 'direct', 'accepted', 'withdrawn']
        && d.createdAt is number && d.updatedAt is number
        && (!('decidedAt' in d) || d.decidedAt is number)
        && (!('decidedBy' in d) || d.decidedBy is string)
        && (!('test' in d) || d.test == true);
    }
    // A family writing its OWN request: 'pending' or 'withdrawn', or 'direct' only for "rijdt niet mee" (a day coordinator's own new times are a request too).
    // It can never write 'accepted'. 'decidedBy' may only name itself (on a direct request).
    function ownRequestOk(reqId) {
      let d = request.resource.data;
      return isLinked() && d.familyId == linkedFamilyId() && validRequest(reqId)
        && d.status in ['pending', 'direct', 'withdrawn']
        && (d.status != 'direct' || d.rides == false)
        && (!('decidedAt' in d || 'decidedBy' in d) || (d.status in ['direct', 'withdrawn'] && d.decidedBy == d.familyId));
    }
    match /weekRequests/{reqId} {
      // Every linked family reads the requests (times only, no reason is stored): a parent sees what is asked on a day, the day
      // coordinator decides. Only the owner changes a request; the day coordinator only agrees.
      // get: judged by the document id (week_day_family), so that asking for a request that does not exist yet gets an empty answer,
      // not an error (the app listens to the known ids). list: any linked family or the coordinator (the app asks for one week with a where on weekKey, to read less).
      allow get: if isCoordinator() || isLinked();
      allow list: if isCoordinator() || isLinked();
      allow create: if ownRequestOk(reqId) || (isCoordinator() && validRequest(reqId));
      // The owner changes or withdraws it (createdAt stays); a replaced accepted request starts over as 'pending'.
      allow update: if (
        (resource.data.familyId == request.resource.data.familyId && request.resource.data.createdAt == resource.data.createdAt
          && ownRequestOk(reqId))
        || (isCoordinator() && validRequest(reqId))
        // The day coordinator agrees: a pending request becomes 'accepted' and only these fields change.
        || (mayDecideRequest(resource.data.day) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'updatedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.decidedAt is number && request.resource.data.decidedBy is string
          && request.resource.data.updatedAt is number)
        // "Ongedaan": the day coordinator takes his own agreement back: accepted becomes pending again, without the decision fields.
        || (mayDecideRequest(resource.data.day) && resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'updatedAt'])
          && request.resource.data.status == 'pending'
          && !('decidedAt' in request.resource.data) && !('decidedBy' in request.resource.data)
          && request.resource.data.updatedAt is number));
      allow delete: if isCoordinator()
        || (isLinked() && resource.data.familyId == linkedFamilyId() && resource.data.status in ['pending', 'withdrawn']);
    }

    // ---- Deviations (Dagafwijking): any member may read/write ----------------------
    // Deletes are refused until the deviation's own `expiresAt`, so a stale browser tab still
    // living in last week can never wipe this week's changes.
    match /deviations/{docId} {
      allow read: if isMember();
      allow create, update: if isMember();
      allow delete: if isMember() && (
        !('expiresAt' in resource.data) || request.time.toMillis() >= resource.data.expiresAt
      );
    }

    // ---- Perioden met andere tijden: the periods themselves (doc id = the first day) ----
    // Members read (every parent sees the task and the dates). Only the coordinator writes. `deadlineAt` is the deadline as a moment (ms):
    // the rules below compare it with the server clock. Periods never share a day; that is checked in the app, not here.
    match /periods/{firstDay} {
      allow read: if isMember();
      allow create, update: if isCoordinator()
        && request.resource.data.keys().hasOnly(['name', 'firstDay', 'lastDay', 'opensOn', 'deadlineDate', 'deadlineTime', 'deadlineAt'])
        && request.resource.data.firstDay == firstDay
        && request.resource.data.name is string && request.resource.data.lastDay is string
        && request.resource.data.deadlineAt is number;
      allow delete: if isCoordinator();
    }

    // ---- Periode met andere tijden: times a family hands in (doc id = <firstDay>_<familyId>) ----
    // Members read. The coordinator writes for anyone, at any time. A parent writes only for the OWN family, only for an existing period,
    // and only before THAT period's deadline (periods/<firstDay>.deadlineAt, ms, saved by Beheer): the server clock decides, not the phone.
    // The first version of the app kept one period in settings/period: it counts as the period with its first day until it is moved.
    function periodOf(first) {
      return exists(/databases/$(database)/documents/periods/$(first))
        ? get(/databases/$(database)/documents/periods/$(first)).data
        : get(/databases/$(database)/documents/settings/period).data;
    }
    function periodOpenForMyFamily(entryId) {
      let d = request.resource.data;
      let p = periodOf(d.periodFirstDay);
      return isLinked()
        && d.familyId == linkedFamilyId()
        && p.firstDay == d.periodFirstDay
        && entryId == p.firstDay + '_' + linkedFamilyId()
        && ('deadlineAt' in p) && p.deadlineAt is number
        && request.time.toMillis() < p.deadlineAt;
    }
    match /periodEntries/{entryId} {
      allow read: if isMember();
      allow create, update: if (isCoordinator() || periodOpenForMyFamily(entryId))
        && request.resource.data.keys().hasOnly(['familyId', 'periodFirstDay', 'days', 'submittedAt', 'by'])
        && request.resource.data.familyId is string
        && request.resource.data.periodFirstDay is string
        && request.resource.data.days is map;
      allow delete: if isCoordinator();
    }

    // ---- Periode met andere tijden: the temporary rooster (doc id = <firstDay>_<date>_<direction>) ----
    // Members read (Mijn week and Rooster show it); only the coordinator writes.
    match /periodCars/{shiftId} {
      allow read: if isMember();
      allow create, update: if isCoordinator()
        && request.resource.data.keys().hasOnly(['periodFirstDay', 'date', 'direction', 'cars', 'madeAt', 'by'])
        && request.resource.data.periodFirstDay is string
        && request.resource.data.date is string
        && request.resource.data.direction in ['heen', 'terug']
        && request.resource.data.cars is list;
      allow delete: if isCoordinator();
    }

    // ---- Perioden met andere tijden: back-ups of one period (doc id = <firstDay>_<ms> or <firstDay>_auto) ----
    // Coordinator only, also for reading: a back-up holds what families handed in. `period`, `entries` and `cars` are copies of the documents above.
    match /periodBackups/{backupId} {
      allow read: if isCoordinator();
      allow create, update: if isCoordinator()
        && request.resource.data.keys().hasOnly(['periodFirstDay', 'createdAt', 'by', 'auto', 'period', 'entries', 'cars'])
        && request.resource.data.periodFirstDay is string
        && request.resource.data.createdAt is number
        && request.resource.data.period is map
        && request.resource.data.entries is map
        && request.resource.data.cars is map;
      allow delete: if isCoordinator();
    }

    // ---- Ritbeurs: rides offered for take-over, "Ik kan inspringen" moments and in-app notifications ----
    // The feature switch settings/ritbeurs ({ on: true }, written by the coordinator in Beheer) gates every CREATE and UPDATE below, so
    // switching it off stops offers, take-overs and notifications at once, for everyone, whatever app version is open. Deleting stays allowed.
    function ritbeursOn() {
      let p = /databases/$(database)/documents/settings/ritbeurs;
      return exists(p) && get(p).data.on == true;
    }
    // An offer: any member reads. A family offers only its OWN ride. While the offer is still 'open' it can change in exactly three ways:
    // taken over by another family (first yes wins: the second batch finds it no longer 'open' and fails as a whole), withdrawn by the
    // offerer (or the coordinator), or marked once as 'not covered' (uncoveredAt) by whichever app notices the deadline first.
    match /offers/{offerId} {
      allow read: if isMember();
      allow create: if ritbeursOn() && isLinked()
        && request.resource.data.keys().hasOnly(['weekKey', 'day', 'direction', 'date', 'time', 'offeredBy', 'message', 'status', 'createdAt'])
        && request.resource.data.offeredBy == linkedFamilyId()
        && request.resource.data.status == 'open'
        && request.resource.data.direction in ['heen', 'terug']
        && request.resource.data.message is string && request.resource.data.message.size() <= 60;
      allow update: if ritbeursOn() && isMember() && resource.data.status == 'open' && (
        (isLinked()
          && request.resource.data.status == 'taken'
          && request.resource.data.takenBy == linkedFamilyId()
          && resource.data.offeredBy != linkedFamilyId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takenBy', 'takenAt']))
        || (request.resource.data.status == 'withdrawn'
          && (isCoordinator() || (isLinked() && resource.data.offeredBy == linkedFamilyId()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt']))
        || (!('uncoveredAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uncoveredAt']))
      );
      allow delete: if isCoordinator();
    }
    // A back-up moment: members read; a family writes only its own; the owner or the coordinator deletes (also when the switch is off).
    match /backupMoments/{momentId} {
      allow read: if isMember();
      allow create, update: if ritbeursOn() && isLinked()
        && request.resource.data.keys().hasOnly(['familyId', 'date', 'from', 'to', 'onlyIfFree', 'createdAt'])
        && request.resource.data.familyId == linkedFamilyId();
      allow delete: if isCoordinator() || (isLinked() && resource.data.familyId == linkedFamilyId());
    }
    // In-app notifications, one folder per family, so a family can only read its own. Any member may leave one for another family, but only
    // while the switch is on; the receiver (or the coordinator) reads, marks as read (only `read` may change) and deletes.
    match /families/{familyId}/notifications/{notificationId} {
      allow read: if isCoordinator() || (isLinked() && linkedFamilyId() == familyId);
      allow create: if ritbeursOn() && isMember()
        && request.resource.data.keys().hasOnly(['kind', 'toFamilyId', 'sourceId', 'fromFamilyId', 'weekKey', 'day', 'direction', 'date', 'time', 'momentFrom', 'momentTo', 'createdAt', 'deliverAt', 'expiresAt', 'read'])
        && request.resource.data.toFamilyId == familyId;
      allow update: if isLinked() && linkedFamilyId() == familyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isCoordinator() || (isLinked() && linkedFamilyId() == familyId);
    }

    // ---- Push (see README "Push-meldingen (test en live)") ----------------
    // A device is a browser that wants pushes. Two kinds, both in pushDevices/:
    //  - a TEST device of the coordinator (owner 'coordinator'): only the coordinator creates, reads or changes it;
    //  - a parent's own phone (owner 'family', with the familyId of that parent): a member creates it only for the OWN family and only while the
    //    push switch on the Ritten-ruilen card is on (settings/push.live == true), and may read, change or remove it only for the own family.
    //    Nobody lists the collection but the coordinator, so a parent never sees another family's phones.
    // The server job reads and writes with its own service account (it does not go through these rules).
    function pushLiveOn() {
      let p = /databases/$(database)/documents/settings/push;
      return exists(p) && get(p).data.live == true;
    }
    function ownDevice() { return isLinked() && ('familyId' in resource.data) && resource.data.familyId == linkedFamilyId(); }
    match /pushDevices/{deviceId} {
      allow list: if isCoordinator();
      allow get: if isCoordinator() || (isLinked() && (resource == null || ownDevice()));
      allow delete: if isCoordinator() || ownDevice();
      allow create: if (isCoordinator()
          && request.resource.data.keys().hasOnly(['owner', 'uid', 'endpoint', 'p256dh', 'auth', 'label', 'categories', 'createdAt', 'lastOkAt', 'familyId'])
          && request.resource.data.owner == 'coordinator'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.endpoint.matches('^https://[a-z0-9.-]+/.+$'))
        || (isLinked() && pushLiveOn()
          && request.resource.data.keys().hasOnly(['owner', 'uid', 'endpoint', 'p256dh', 'auth', 'label', 'categories', 'createdAt', 'lastOkAt', 'familyId'])
          && request.resource.data.owner == 'family'
          && request.resource.data.familyId == linkedFamilyId()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.endpoint.matches('^https://[a-z0-9.-]+/.+$'));
      // The coordinator may change any field of a device and makes it (or keeps it) a test device; a parent only the address and the label of
      // a phone of the own family, never its kind or its family.
      allow update: if (isCoordinator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'uid', 'endpoint', 'p256dh', 'auth', 'label', 'categories', 'lastOkAt', 'familyId'])
          && request.resource.data.owner == 'coordinator'
          && request.resource.data.endpoint.matches('^https://[a-z0-9.-]+/.+$'))
        || (ownDevice() && pushLiveOn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'endpoint', 'p256dh', 'auth', 'label'])
          && request.resource.data.endpoint.matches('^https://[a-z0-9.-]+/.+$'));
    }
    match /pushQueue/{entryKey} {
      allow read, delete: if isCoordinator();
      allow create: if request.resource.data.keys().hasOnly(['path', 'toFamilyId', 'kind', 'deliverAt', 'expiresAt', 'createdAt', 'test', 'manual'])
        && (isCoordinator()
          || (ritbeursOn() && isMember() && request.resource.data.test == false && !('manual' in request.resource.data)
            && request.resource.data.path.matches('^families/[^/]+/notifications/[^/]+$')
            && request.resource.data.path.split('/')[1] == request.resource.data.toFamilyId));
    }
    match /testNotifications/{testId} {
      allow read, write: if isCoordinator();
    }

    // ---- Weekend match carpools: any member ----------------------------------------
    // ---- Gereden shifts (solidarity overview in Beheer): written and read by the coordinator only ----
    match /rideLog/{docId} {
      allow read, write: if isCoordinator();
    }

    // ---- Agenda link (calendar subscription, Profiel > Agenda) ---------------------
    // calendarTokens/<familyId> = { token, createdAt }: the secret in the link https://azcarpool.nl/agenda/<token>.ics of one family.
    // Only that family and the coordinator can read it (the server job reads it with its own key). A family makes it once and nobody can
    // replace it (no update), so the link a family put in its calendar keeps working; only the coordinator can remove it (then the app
    // makes a new one). The token must be exactly 32 URL-safe characters: the server job uses it as a file name.
    match /calendarTokens/{familyId} {
      allow get: if isCoordinator() || (isLinked() && linkedFamilyId() == familyId);
      allow create: if (isCoordinator() || (isLinked() && linkedFamilyId() == familyId))
        && request.resource.data.keys().hasOnly(['token', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{32}$')
        && request.resource.data.createdAt is number;
      allow delete: if isCoordinator();
    }

    // driverCalendarTokens/<familyId> = { token, createdAt }: the secret in the link of the calendar with the rides this family DRIVES
    // (the parents' agenda). Exactly the same rules as calendarTokens above: that family and the coordinator read it, it is made once, never
    // replaced, and only the coordinator can remove it. The server job treats both kinds of secret as file names, so they never overlap.
    match /driverCalendarTokens/{familyId} {
      allow get: if isCoordinator() || (isLinked() && linkedFamilyId() == familyId);
      allow create: if (isCoordinator() || (isLinked() && linkedFamilyId() == familyId))
        && request.resource.data.keys().hasOnly(['token', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{32}$')
        && request.resource.data.createdAt is number;
      allow delete: if isCoordinator();
    }

    match /matchCarpools/{matchSlug} {
      allow read, write: if isMember();
    }

    // Practice matches (oefenwedstrijden): every linked parent (and the coordinator) can add, change and remove them.
    // The shape is checked so a bad write cannot break the Wedstrijden tab for everyone.
    match /practiceMatches/{practiceId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['calendarId', 'teamLabel', 'opponent', 'isHome', 'location', 'startMs', 'createdAt'])
        && request.resource.data.calendarId is string
        && request.resource.data.teamLabel is string
        && request.resource.data.opponent is string && request.resource.data.opponent.size() > 0 && request.resource.data.opponent.size() <= 60
        && request.resource.data.isHome is bool
        && request.resource.data.location is string && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 120
        && request.resource.data.startMs is number;
    }
  }
}
