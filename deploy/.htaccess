# AZ Carpool: server settings for azcarpool.nl (Apache). Shipped by `npm run build:deploy`; source: deploy/.htaccess in the repo.
DirectoryIndex index.html
Options -Indexes

# Always https (and the bare domain, no www). The extra X-Forwarded-Proto check prevents a redirect loop behind a proxy.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.azcarpool\.nl$ [NC]
RewriteRule ^ https://azcarpool.nl%{REQUEST_URI} [L,R=301]

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Private group app: keep it out of search engines.
  Header always set X-Robots-Tag "noindex, nofollow"
  # The app and the service worker must always be re-checked, otherwise phones do not see an update.
  <FilesMatch "\.(html|js|mjs|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
