# AZ Carpool: server settings for azcarpool.nl (Apache). Shipped by `npm run build:deploy`; source: deploy/.htaccess in the repo.
DirectoryIndex index.html
Options -Indexes

# Always https (and the bare domain, no www). The extra X-Forwarded-Proto check prevents a redirect loop behind a proxy.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.azcarpool\.nl$ [NC]
RewriteRule ^ https://azcarpool.nl%{REQUEST_URI} [L,R=301]

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Browsers only run our own files, the Firebase SDK from gstatic and the three inline scripts of index.html (their hashes are filled in by
  # `npm run build:deploy`, see scripts/build-deploy.mjs). Hosts in connect-src: gstatic (the service worker, which gets this header too, fetches the Firebase SDK from there), Firestore, anonymous sign-in, Google Calendar and OpenRouteService.
  # style-src keeps 'unsafe-inline' because the app still has style="..." attributes (DESIGN.md ratchet); scripts do not.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://www.gstatic.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://api.openrouteservice.org; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  # Always https for a year. No includeSubDomains/preload on purpose: that would bind every other subdomain of azcarpool.nl too.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Private group app: keep it out of search engines.
  Header always set X-Robots-Tag "noindex, nofollow"
  # The app and the service worker must always be re-checked, otherwise phones do not see an update.
  <FilesMatch "\.(html|js|mjs|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
